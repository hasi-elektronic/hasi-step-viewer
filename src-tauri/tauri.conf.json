{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hasi STEP-Betrachter",
  "version": "0.1.0",
  "identifier": "de.hasi-elektronic.stepviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hasi STEP-Betrachter",
        "width": 1400,
        "height": 880
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Hasi Elektronic",
    "shortDescription": "STEP-Betrachter für 3D-Modelle",
    "longDescription": "Betrachter für STEP-/STP-Dateien: Modellbaum, Messen, Schnittansicht. Nur Ansicht, keine Bearbeitung.",
    "category": "Utility",
    "copyright": "© 2026 Hasi Elektronic",
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "de-DE"
      }
    }
  },
  "mainBinaryName": "hasi-step-betrachter"
}