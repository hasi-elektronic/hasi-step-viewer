{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hasi 3D",
  "version": "0.1.3",
  "identifier": "de.hasi-elektronic.stepviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hasi 3D",
        "width": 1400,
        "height": 880,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Hasi Elektronic",
    "shortDescription": "Hasi 3D – Betrachter für STEP-Modelle",
    "longDescription": "Hasi 3D: Betrachter für STEP-/STP-Dateien: Modellbaum, Messen, Schnittansicht. Nur Ansicht, keine Bearbeitung.",
    "category": "Utility",
    "copyright": "© 2026 Hasi Elektronic",
    "fileAssociations": [
      {
        "ext": ["step", "stp"],
        "name": "HasiStep",
        "description": "STEP-Datei (.step, .stp)",
        "role": "Viewer",
        "mimeType": "model/step",
        "rank": "Default",
        "exportedType": {
          "identifier": "de.hasi-elektronic.step",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": "de-DE",
        "template": "windows/main.wxs",
        "upgradeCode": "8058eeb3-a5b1-5569-a5d1-b51db6fb06e8"
      }
    }
  },
  "mainBinaryName": "hasi-3d"
}
