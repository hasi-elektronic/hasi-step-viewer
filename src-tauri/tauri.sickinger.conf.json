          "identifier": "de.sickinger.step",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "icon": [
      "icons-sickinger/32x32.png",
      "icons-sickinger/128x128.png",
      "icons-sickinger/128x128@2x.png",
      "icons-sickinger/icon.icns",
      "icons-sickinger/icon.ico"
    ]
  },
  "mainBinaryName": "ms3d"
